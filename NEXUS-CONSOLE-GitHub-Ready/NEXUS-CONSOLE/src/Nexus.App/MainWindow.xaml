<Window x:Class="Nexus.Shell.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="NEXUS" Width="1600" Height="900" MinWidth="960" MinHeight="540"
        Background="{DynamicResource BgBrush}" Foreground="{DynamicResource TextBrush}"
        FontFamily="Segoe UI Variable Text, Segoe UI" UseLayoutRounding="True">
  <Grid x:Name="Root">
    <Grid.LayoutTransform>
      <ScaleTransform x:Name="UiScale" ScaleX="1" ScaleY="1"/>
    </Grid.LayoutTransform>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
    </Grid.RowDefinitions>

    <!-- Ambiance : teinte douce en haut de l'écran, selon le jeu sélectionné -->
    <Rectangle Grid.RowSpan="2" IsHitTestVisible="False">
      <Rectangle.Fill>
        <LinearGradientBrush StartPoint="0.5,0" EndPoint="0.5,1">
          <GradientStop x:Name="AmbTop" Color="#00000000" Offset="0"/>
          <GradientStop x:Name="AmbBottom" Color="#00000000" Offset="0.85"/>
        </LinearGradientBrush>
      </Rectangle.Fill>
    </Rectangle>

    <Grid Margin="40,24,40,8">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto"/>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="Auto"/>
      </Grid.ColumnDefinitions>
      <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
        <Ellipse Width="14" Height="14" Fill="{DynamicResource AccentBrush}" Margin="0,0,10,0"/>
        <TextBlock Text="NEXUS" FontSize="26" FontWeight="Bold"/>
        <Border x:Name="Avatar" Width="34" Height="34" CornerRadius="17" Margin="20,0,8,0" Background="{DynamicResource AccentSoftBrush}">
          <TextBlock x:Name="AvatarText" FontSize="14" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Border>
        <TextBlock x:Name="ProfileName" FontSize="14" VerticalAlignment="Center" Foreground="{DynamicResource TextDimBrush}"/>
      </StackPanel>
      <WrapPanel x:Name="Tabs" Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="24,0"/>
      <StackPanel Grid.Column="2" HorizontalAlignment="Right" VerticalAlignment="Center">
        <TextBlock x:Name="ClockText" FontSize="26" FontWeight="SemiBold" HorizontalAlignment="Right"/>
        <TextBlock x:Name="DateText" FontSize="13" Foreground="{DynamicResource TextDimBrush}" HorizontalAlignment="Right"/>
        <TextBlock x:Name="NetText" FontSize="13" Foreground="{DynamicResource TextDimBrush}" HorizontalAlignment="Right"/>
        <TextBlock x:Name="PadText" FontSize="13" Foreground="{DynamicResource TextDimBrush}" HorizontalAlignment="Right"/>
      </StackPanel>
    </Grid>

    <ContentControl x:Name="Host" Grid.Row="1" Margin="40,8,40,32" IsTabStop="False" Focusable="False"
                    HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"/>

    <TextBlock x:Name="ToastText" Grid.Row="1" VerticalAlignment="Bottom" HorizontalAlignment="Left" Margin="44,0,0,8"
               FontSize="14" Foreground="{DynamicResource TextDimBrush}" Opacity="0" IsHitTestVisible="False"/>
    <TextBlock x:Name="HintText" Grid.Row="1" VerticalAlignment="Bottom" HorizontalAlignment="Right" Margin="0,0,44,8"
               FontSize="14" Foreground="{DynamicResource TextDimBrush}" Visibility="Collapsed" IsHitTestVisible="False"/>

    <!-- Lancement d'un jeu : visible jusqu'à la détection du jeu, puis la fenêtre est réduite -->
    <Border x:Name="Overlay" Grid.RowSpan="2" Background="#E6000000" Visibility="Collapsed" Panel.ZIndex="10">
      <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
        <TextBlock x:Name="OverlayTitle" FontSize="34" FontWeight="Bold" Foreground="White" TextAlignment="Center" TextWrapping="Wrap"/>
        <TextBlock x:Name="OverlayHint" FontSize="16" Foreground="#B0FFFFFF" TextAlignment="Center" Margin="0,12,0,0"/>
      </StackPanel>
    </Border>
  </Grid>
</Window>
